{
  "framework": null,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/painel", "destination": "/admin.html" },
    { "source": "/data/:path*", "destination": "/404.html" },
    { "source": "/lib/:path*", "destination": "/404.html" },
    { "source": "/scripts/:path*", "destination": "/404.html" },
    { "source": "/api/:path*", "destination": "/api" }
  ]
}
